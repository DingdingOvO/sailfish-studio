!(\"{:?}\", foo);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"sf-parser/src/sf.rs","byte_start":20553,"byte_end":20571,"line_start":646,"line_end":646,"column_start":15,"column_end":33,"is_primary":true,"text":[{"text":"            ..Default::default()","highlight_start":15,"highlight_end":33}],"label":"the trait `Default` is not implemented for `sf::SfProject`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"consider annotating `sf::SfProject` with `#[derive(Default)]`","code":null,"level":"help","spans":[{"file_name":"sf-parser/src/sf.rs","byte_start":762,"byte_end":762,"line_start":19,"line_end":19,"column_start":1,"column_end":1,"is_primary":true,"text":[{"text":"pub struct SfProject {","highlight_start":1,"highlight_end":1}],"label":null,"suggested_replacement":"#[derive(Default)]\n","suggestion_applicability":"MaybeIncorrect","expansion":null}],"children":[],"rendered":null}],"rendered":"\u001b[1m\u001b[91merror[E0277]\u001b[0m\u001b[1m: the trait bound `sf::SfProject: Default` is not satisfied\u001b[0m\n   \u001b[1m\u001b[94m--> \u001b[0msf-parser/src/sf.rs:646:15\n    \u001b[1m\u001b[94m|\u001b[0m\n\u001b[1m\u001b[94m646\u001b[0m \u001b[1m\u001b[94m|\u001b[0m             ..Default::default()\n    \u001b[1m\u001b[94m|\u001b[0m               \u001b[1m\u001b[91m^^^^^^^^^^^^^^^^^^\u001b[0m \u001b[1m\u001b[91mthe trait `Default` is not implemented for `sf::SfProject`\u001b[0m\n    \u001b[1m\u001b[94m|\u001b[0m\n\u001b[1m\u001b[96mhelp\u001b[0m: consider annotating `sf::SfProject` with `#[derive(Default)]`\n    \u001b[1m\u001b[94m|\u001b[0m\n\u